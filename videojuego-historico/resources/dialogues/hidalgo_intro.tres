[sub_resource type="Resource" id="Resource_n7gs6"]
script = ExtResource("1_8qqu3")
text = "¡Bienvenido, viajero del tiempo! El destino de la patria está en juego."

[sub_resource type="Resource" id="Resource_ufahi"]
script = ExtResource("1_8qqu3")
text = "Necesito que evites la tragedia en la plaza antes de que sea demasiado tarde."

[sub_resource type="Resource" id="Resource_q23wh"]
script = ExtResource("1_8qqu3")
text = "Busca la bolsa de monedas y entrégala a tiempo... ¡rápido!"

