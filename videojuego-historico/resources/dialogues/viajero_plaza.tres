[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_line")
text = "Buenos días, viajero. La plaza de Dolores está en calma... por ahora."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_line")
text = "El cura Hidalgo espera junto al camino. Ve a hablar con él antes de que anochezca."

[resource]
script = ExtResource("2_dlg")
npc_name = "Viajero"
lines = Array[ExtResource("1_line")]([SubResource("Resource_l0"), SubResource("Resource_l1")])
